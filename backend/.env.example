PORT=3001
APP_ENV=dev
STATIC_DIR=../public
# Dossier de base sur le NAS (passé au gateway)
PHOTOS_DIR=/volume1/JTSLAB/photos-chantiers
# Certificat TLS Tailscale (généré via : tailscale cert nas-jts.persian-kelvin.ts.net)
# Sur Synology : activer d'abord avec sudo tailscale set --operator=$USER
TLS_CERT=/var/services/homes/Satemorej/nas-jts.persian-kelvin.ts.net.crt
TLS_KEY=/var/services/homes/Satemorej/nas-jts.persian-kelvin.ts.net.key
# CORS origin (frontend)
ALLOWED_ORIGIN=https://nas-jts.persian-kelvin.ts.net:5656
# jts-nas-gateway
GATEWAY_URL=http://127.0.0.1:3003
GATEWAY_API_KEY=<clé à créer>
